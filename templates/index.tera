<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{ page_title }}</title>
        <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --accent: #38bdf8;
      --text: #f8fafc;
      --subtext: #94a3b8;
      --border: #334155;
      --badge-bg: #0369a1;
    }
    body {
      margin: 0;
      padding: 2rem;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-color);
      color: var(--text);
    }
    .header {
      margin-bottom: 2rem;
    }
    h1 { margin: 0; color: var(--accent); font-size: 2rem; }
    p.subtitle { color: var(--subtext); margin-top: 0.5rem; }
    .card {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 1.5rem;
      border: 1px solid var(--border);
      margin-bottom: 1.5rem;
    }
    .spot-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }
    .spot-card {
      background: var(--bg-color);
      padding: 1rem;
      border-radius: 8px;
      border: 1px solid var(--border);
    }
    .spot-name {
      font-weight: bold;
      font-size: 1.1rem;
      color: var(--accent);
    }
    .param-list {
      list-style: none;
      padding: 0;
      margin: 1rem 0 0 0;
    }
    .param-list li {
      display: flex;
      justify-content: space-between;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--border);
    }
    .param-list li:last-child {
      border-bottom: none;
    }
    .status-enabled {
      color: #4ade80;
      font-weight: bold;
    }
    .status-disabled {
      color: #f87171;
      font-weight: bold;
    }
        </style>
    </head>
    <body>
        <div class="header">
            <h1>🌊 {{ page_title }}</h1>
            <p class="subtitle">Configured directly via Home Assistant Add-on Settings</p>
        </div>
        <div class="card">
            <h2>Monitored Spots ({{ spots | length }})</h2>
            <div class="spot-grid">
                {% for spot in spots %}
                    <div class="spot-card">
                        <div class="spot-name">{{ spot.name }}</div>
                    </div>
                {% else %}
                    <p>No spots configured in Home Assistant options.</p>
                {% endfor %}
            </div>
        </div>
    </body>
</html>
